# Required: DashScope key
DASHSCOPE_API_KEY=

# DashScope realtime ws endpoint
DASHSCOPE_BASE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference

# ASR model
DASHSCOPE_ASR_MODEL=fun-asr-realtime

# Local ASR bridge server (browser/gateway -> this service)
ASR_WS_HOST=0.0.0.0
ASR_WS_PORT=10094
ASR_AUDIO_FORMAT=pcm
ASR_SAMPLE_RATE=16000

# Fixed full-table FunASR hotwords for the production accuracy comparison.
ASR_PREPROCESS_HOTWORD_MODE=full
ASR_FULL_HOTWORD_FILE=/home/twai/huilong/full_question_v6_strata/asr_api_use/hotwords_taxonomy_12x72/full.txt
# Scene-aware mode remains available by setting mode=scene_dynamic.
ASR_SCENE_HOTWORD_DIR=/home/twai/wjl/DynamicHotwordLoading/hotwords
# 场景库不截断；地址候选按权重排序后最多加载 1000 条。
ASR_MAX_HOTWORDS=0
ASR_MAX_ADDRESS_HOTWORDS=1000
ASR_HOTWORD_WARNING_THRESHOLD=800

# Real location address-scope environment. The referenced file supplies only
# the dedicated hotword MQ/DB reader credentials and must remain mode 600.
ASR_ADDRESS_SCOPE_CREDENTIAL_ENV_FILE=/home/twai/wjx/location-real/.env
ASR_ADDRESS_SCOPE_MQ_ENABLED=true
ASR_ADDRESS_SCOPE_MQ_HOST=192.168.173.167
ASR_ADDRESS_SCOPE_MQ_PORT=5673
ASR_ADDRESS_SCOPE_MQ_VHOST=/location-real
ASR_ADDRESS_SCOPE_MQ_QUEUE=location.real.address-scope.hotword.v1
ASR_ADDRESS_SCOPE_MQ_HANDLER_TIMEOUT_SECONDS=15
ASR_ADDRESS_SCOPE_MQ_RECONNECT_MAX_SECONDS=30
ASR_ADDRESS_SCOPE_PENDING_TTL_SECONDS=1800
ASR_ADDRESS_SCOPE_PENDING_MAX_ENTRIES=10000

# Query source: database reads the already materialized logical scope by scopeId.
# It does not execute coordinate or PostGIS spatial calculations. REST remains a fallback.
ASR_ADDRESS_SCOPE_SOURCE=database
ASR_ADDRESS_SCOPE_DB_HOST=192.168.173.167
ASR_ADDRESS_SCOPE_DB_PORT=15433
ASR_ADDRESS_SCOPE_DB_NAME=dispatch_assist
ASR_ADDRESS_SCOPE_DB_CONNECT_TIMEOUT=5
ASR_ADDRESS_SCOPE_BASE_URL=http://192.168.173.167:18082
ASR_ADDRESS_SCOPE_TIMEOUT_SECONDS=3
ASR_ADDRESS_SCOPE_PAGE_SIZE=1000
ASR_ADDRESS_SCOPE_MAX_PAGES=100
ASR_ADDRESS_SCOPE_MAX_ATTEMPTS=2

# Executive demo fixed real-location scenario. The 18448 demo calls this REST
# endpoint and reads the resulting scope with the real read-only DB account.
HOTWORD_DEMO_LOCATION_BASE_URL=http://192.168.173.167:18082
HOTWORD_DEMO_LOCATION_LONGITUDE=113.93924230
HOTWORD_DEMO_LOCATION_LATITUDE=22.55250952
HOTWORD_DEMO_LOCATION_RADIUS_METERS=2000
HOTWORD_DEMO_LOCATION_ACCURACY_METERS=30
HOTWORD_DEMO_LOCATION_INVENTORY_VERSION=ODS7ALM_AI_REAL_20260810_V1
HOTWORD_DEMO_LOCATION_TIMEOUT_SECONDS=10

# HTTPS gateway (public entry)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
TLS_CERT_FILE=./cert.pem
TLS_KEY_FILE=./key.pem
GATEWAY_WEB_DIR=./web

# Native GPU Paraformer-large baseline used by /asr-accuracy-a.
ASR_ACCURACY_BASELINE_UPSTREAM_WS=ws://127.0.0.1:10098


# Optional certificate SAN values for public HTTPS testing.
# For a public IP, include that IP in TLS_IP_NAMES before regenerating cert.pem.
TLS_DNS_NAMES=localhost
TLS_IP_NAMES=127.0.0.1

# Optional business API reverse proxy, set empty to disable
API_UPSTREAM=
