# Docker/Compose settings (read by Compose before container startup)
FUNASR_MODEL_DIR=/absolute/path/to/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_NCPU=4
FUNASR_PUBLISHED_PORT=10097
ASR_GATEWAY_PUBLISHED_PORT=8443

# Gateway TLS. Development certificates are generated automatically in ./certs.
TLS_CN=localhost
TLS_DNS_NAMES=localhost
TLS_IP_NAMES=127.0.0.1

# Optional business API reverse proxy.
API_UPSTREAM=

# Database persistence and address correction (disabled when false).
ASR_DB_ENABLED=false
ASR_ADDRESS_DB_ENABLED=false
ASR_DB_HOST=
ASR_DB_PORT=5432
ASR_DB_NAME=
ASR_DB_USER=
ASR_DB_PASS=
ASR_DB_SCHEMA=ai
ASR_DB_TABLE=asr_speech_recognition
ASR_DB_CREATE_BY=asr-bridge
ASR_DB_CONNECT_TIMEOUT=5
ASR_ADDRESS_DB_SCHEMA=ai
ASR_ADDRESS_DB_FIELDS=
ASR_ADDRESS_DB_MIN_TERM_LENGTH=3

# RabbitMQ publishing (disabled when false).
ASR_RABBITMQ_ENABLED=false
ASR_RABBITMQ_HOST=
ASR_RABBITMQ_PORT=5672
ASR_RABBITMQ_VHOST=ai
ASR_RABBITMQ_USER=guest
ASR_RABBITMQ_PASS=guest
ASR_RABBITMQ_EXCHANGE=ids:asr
ASR_RABBITMQ_SOURCE=ids:asr
ASR_RABBITMQ_ROUTING_PREFIX=asr
ASR_RABBITMQ_QS_ENABLED=false

# Frontend delivery through message-client. Keep secrets outside version control.
ASR_MESSAGE_ENABLED=false
UAC_BASE_URL=http://ids-dev.ks.telewave.tech/uac-client
UAC_CLIENT_ID=ids-asr-service
UAC_CLIENT_SECRET=
MESSAGE_SEND_URL=http://ids-dev.ks.telewave.tech/message-client/messages/send
MESSAGE_TENANT_ID=
ASR_MESSAGE_TARGET_CLIENT=ids-seat-web
ASR_MESSAGE_TARGET_DESC=坐席端
ASR_MESSAGE_QUEUE_SIZE=1000
ASR_MESSAGE_CONNECT_TIMEOUT_SECONDS=3
ASR_MESSAGE_TOTAL_TIMEOUT_SECONDS=10
ASR_MESSAGE_TOKEN_EXPIRY_SKEW_SECONDS=60
ASR_MESSAGE_RETRY_DELAY_SECONDS=0.5
ASR_MESSAGE_SHUTDOWN_DRAIN_SECONDS=3
ASR_MESSAGE_FALLBACK_RABBITMQ=false
# Optional DNS workaround: connect to the gateway IP while preserving the HTTP Host header.
ASR_MESSAGE_GATEWAY_IP=
ASR_MESSAGE_HOST_HEADER=

# Optional LLM correction/highlighting.
ASR_AI_CORRECTION_ENABLED=false
ASR_CORRECTION_PROVIDER=rule
ASR_HIGHLIGHT_PROVIDER=rule
ASR_LLM_BASE_URL=
ASR_LLM_API_KEY=
ASR_LLM_MODEL=
ASR_LLM_PROXY=
ASR_LLM_MAX_TOKENS=512

# Recording storage. Local recordings persist under ./recordings.
ASR_RECORDING_STORE=local
ASR_RECORDING_UPLOAD_URL=
ASR_RECORDING_DOWNLOAD_URL_TEMPLATE=
ASR_RECORDING_AUTH_TOKEN=
ASR_RECORDING_TENANT_ID=
ASR_RECORDING_UPLOAD_TIMEOUT=10

# VAD defaults.
ASR_VAD_AGGRESSIVENESS=2
ASR_VAD_USE_RAW_AUDIO=true

# Optional Xfyun dialect ASR used by the per-call switch in monitor.html.
# Keep real credentials in the local .env / deployment secret store only.
ASR_XFYUN_ENABLED=false
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
ASR_XFYUN_SAMPLE_RATE=16000
ASR_XFYUN_CONNECT_TIMEOUT_SECONDS=15
ASR_XFYUN_RESULT_TIMEOUT_SECONDS=30
ASR_XFYUN_MAX_SEGMENT_SECONDS=55
ASR_XFYUN_AUDIO_QUEUE_SIZE=256
